{
  "name": "pi-deepseek-cache",
  "version": "0.2.0",
  "description": "DeepSeek prefix-cache extension for pi — hit-rate telemetry, persistent avg-cache display, DeepSeek-only activation, cache backfill on resume, prefix guard, and cache-friendly compaction. (Fork of ruanbw/pi-deepseek-cache)",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write ."
  },
  "keywords": [
    "pi",
    "pi-package",
    "deepseek",
    "cache",
    "prefix-cache",
    "coding-agent",
    "extension",
    "model-filter",
    "cache-backfill"
  ],
  "author": "Freebird415",
  "contributors": [
    "ruanbw"
  ],
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.78.0",
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@earendil-works/pi-tui": "^0.78.0"
  },
  "devDependencies": {
    "vitest": "^3.2.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Freebird415/pi-deepseek-cache-fix.git"
  },
  "bugs": {
    "url": "https://github.com/Freebird415/pi-deepseek-cache-fix/issues"
  },
  "homepage": "https://github.com/Freebird415/pi-deepseek-cache-fix#readme"
}
